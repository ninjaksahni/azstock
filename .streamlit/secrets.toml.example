APP_PASSWORD = "your-password-here"

# Optional: persist settings.json to your GitHub repo (recommended on Streamlit Cloud).
# Create a fine-grained or classic PAT with repo contents read/write on this repository.
# GITHUB_SETTINGS_TOKEN = "ghp_..."
# GITHUB_SETTINGS_REPO = "your-user/azstock"
# GITHUB_SETTINGS_PATH = "data/settings.json"

